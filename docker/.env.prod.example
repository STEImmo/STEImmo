# Copy to /srv/steimmo/shared/.env, chmod 600; never commit real values.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=steimmo-projekt-page.justus.software
DJANGO_CSRF_TRUSTED_ORIGINS=https://steimmo-projekt-page.justus.software
# Actual source IP seen by Gunicorn; see ADR-0018 bootstrap instructions.
DJANGO_LOGIN_THROTTLE_TRUSTED_PROXY_IPS=CHANGE_ME
DJANGO_SECURE_HSTS_SECONDS=0
# Docker host address reachable from the existing Caddy container.
STEIMMO_BIND_IP=172.17.0.1

POSTGRES_DB=steimmo
POSTGRES_USER=steimmo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VOLUME_NAME=steimmo-prod-postgres-data
MEDIA_VOLUME_NAME=steimmo-prod-media-data
TZ=Europe/Berlin

DJANGO_DEFAULT_FROM_EMAIL=CHANGE_ME
DJANGO_EMAIL_HOST=CHANGE_ME
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
# Set a real recipient before enabling callback requests in production.
DJANGO_CALLBACK_RECIPIENTS=
